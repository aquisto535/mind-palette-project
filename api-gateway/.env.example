# ==============================================================================
# API Gateway (Node.js/Express) — 환경 변수 예시
# ==============================================================================
# 이 파일을 복사하여 .env 를 만드세요:
#   cp .env.example .env
# .env 는 .gitignore 대상이므로 커밋하지 마세요.
# ==============================================================================

# [실행 환경] ✅ 필수
# 'production' 설정 시: morgan combined 로그, 레이트리미터 활성화
NODE_ENV=production

# [서버 포트] ⚠️ 권장
# PORT=3000

# [서비스 URL] ✅ 필수 — Docker Compose 환경에서는 서비스명으로 자동 해결됩니다
PREPROCESS_SERVER_URL=http://preprocess-server:8081
AI_SERVER_URL=http://ai-server:8082

# [보안 시크릿] 🔒✅ 필수
# 관리자 프로파일링 키 (X-Admin-Profile-Key 헤더 검증)
# 미설정 시 프로파일링 엔드포인트가 무음으로 비활성화됩니다.
# 프로덕션 배포 전 반드시 강력한 랜덤 값으로 교체하세요.
ADMIN_PROFILE_KEY=CHANGE_ME_BEFORE_PRODUCTION

# [이미지 보존] 🔧 개발 전용
# ❌ 프로덕션에서 true 설정 금지 — 처리된 이미지가 삭제되지 않아 디스크 고갈 위험
KEEP_IMAGES=false

# [캐시 설정] ⚠️ 권장
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=100
