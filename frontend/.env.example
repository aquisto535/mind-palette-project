# ==============================================================================
# Frontend (Vite) — 환경 변수 예시
# ==============================================================================
# ⚠️  VITE_* 변수는 빌드 시점에 번들에 인라인됩니다 (런타임 변경 불가).
#     로컬 개발 시 이 파일을 복사하여 .env.local 을 만드세요:
#       cp .env.example .env.local
#     .env.local 은 .gitignore 대상이므로 커밋하지 마세요.
# ==============================================================================

# [Mock 모드] 실제 API 대신 Mock 데이터 사용 여부
# 🔧 개발/테스트 전용 — 프로덕션 빌드에서는 반드시 false (또는 미설정)
# Docker 빌드 시 .dockerignore가 .env.local을 제외하므로 자동으로 false가 됩니다.
# ❌ 절대로 true 상태로 Docker 이미지를 빌드하지 마세요.
VITE_USE_MOCK=false

# [API URL] Axios baseURL
# Nginx 리버스 프록시 구성(/api → http://api-gateway:3000) 사용 시 기본값(/api)으로 충분합니다.
# 직접 API Gateway에 접근하는 경우에만 변경하세요.
# VITE_API_URL=/api
