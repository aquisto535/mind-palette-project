# ==============================================================================
# Mind Palette - Environment Configuration
# ==============================================================================

# [Security]
# 관리자 전용 프로파일링 시크릿 키 (E2E 테스트 및 벤치마킹 시 사용)
# 이 키를 X-Admin-Profile-Key 헤더에 담아 보내면 Server-Timing 메트릭이 반환됩니다.
ADMIN_PROFILE_KEY=SECRET-1234

# [Service URLs]
# 필요 시 각 서비스의 로컬 주소를 변경할 수 있습니다.
# Docker Compose 환경에서는 서비스명으로 자동 해결됩니다.
# PREPROCESS_SERVER_URL=http://preprocess-server:8081
# AI_SERVER_URL=http://ai-server:8082

# [Cache] 해시 기반 인메모리 LRU 캐시 (Step 4)
# CACHE_TTL_SECONDS=3600   # 캐시 항목 TTL (초), 기본 1시간
# CACHE_MAX_SIZE=100        # 최대 캐시 항목 수 (LRU 정책)

# [Preprocess Server] ADR-028: c5.large vCPU 2 기준
# PREPROCESS_WORKERS=2

# [Image Cleanup]
# KEEP_IMAGES=false   # true로 설정하면 처리 후 이미지를 삭제하지 않음 (개발용)
