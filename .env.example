# ==============================================================================
# Mind Palette - Profile Configurations
# ==============================================================================

# [Security] 
# 관리자 전용 프로파일링 시크릿 키 (E2E 테스트 및 벤치마킹 시 사용)
# 이 키를 X-Admin-Profile-Key 헤더에 담아 보내면 Server-Timing 메트릭이 반환됩니다.
ADMIN_PROFILE_KEY=SECRET-1234

# [Service URLs]
# 필요 시 각 서비스의 로컬 주소를 변경할 수 있습니다.
# PREPROCESS_SERVER_URL=http://127.0.0.1:8081
# AI_SERVER_URL=http://127.0.0.1:8082
