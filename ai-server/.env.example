# ==============================================================================
# AI Server (Python/FastAPI) — 환경 변수 예시
# ==============================================================================
# 이 파일을 복사하여 .env 를 만드세요:
#   cp .env.example .env
# .env 는 .gitignore 대상이므로 커밋하지 마세요.
#
# 설정은 Pydantic BaseSettings로 관리됩니다 (ai-server/src/config.py).
# ==============================================================================

# [추론 백엔드] ✅ 필수
# 사용 가능한 값: pytorch | onnx | tensorrt_native | tensorrt_ort
# 프로덕션 권장: onnx (CPU) 또는 tensorrt_ort (GPU)
# 미설정 시 기본값 'pytorch' 사용 — CPU 추론으로 성능 저하 발생 가능
INFERENCE_BACKEND=onnx

# [디바이스] ⚠️ 권장
# cpu: CPU 추론 (c5.large 등 GPU 없는 인스턴스)
# cuda: GPU 추론 (TensorRT 사용 시 필수)
# DEVICE=cpu
